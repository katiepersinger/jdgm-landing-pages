  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    :root {
      --navy:        #1c3a5e;
      --navy-dark:   #122540;
      --navy-deep:   #0c1a2e;
      --orange:      #e8622a;
      --orange-hover:#cf5221;
      --orange-glow: rgba(232,98,42,0.45);
      --white:       #ffffff;
      --off-white:   #f7f5f2;
      --cream:       #efeae0;
      --text:        #1a1a1a;
      --muted:       #6b6b6b;
      --border:      #ddd8d0;
    }

    body {
      font-family: 'Open Sans', sans-serif;
      color: var(--text);
      background: var(--white);
      -webkit-font-smoothing: antialiased;
    }

    /* ── HERO ── */
    .hero {
      background:
        radial-gradient(ellipse at 80% 20%, rgba(232,98,42,0.18) 0%, transparent 55%),
        linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
      color: var(--white);
      padding: 32px 24px 72px;
      position: relative;
      overflow: hidden;
    }
    .hero-logo {
      display: flex;
      justify-content: center;
      max-width: 1180px;
      margin: 0 auto 40px;
    }
    .hero-logo a {
      display: inline-flex;
      align-items: center;
    }
    .hero-logo svg {
      height: 38px;
      width: auto;
      display: block;
    }
    .hero-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 64px;
      align-items: center;
    }
    .hero-label {
      display: inline-block;
      font-family: 'Open Sans', sans-serif;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 22px;
      padding: 6px 12px;
      background: rgba(232,98,42,0.12);
      border: 1px solid rgba(232,98,42,0.35);
      border-radius: 3px;
    }
    .hero h1 {
      font-family: 'Merriweather', serif;
      font-size: clamp(40px, 5.6vw, 72px);
      font-weight: 900;
      line-height: 1.04;
      color: var(--white);
      margin-bottom: 24px;
      letter-spacing: -0.01em;
    }
    .hero h1 em {
      font-style: italic;
      color: var(--orange);
    }
    .hero-sub {
      font-size: 19px;
      line-height: 1.55;
      color: #d6e2f0;
      margin-bottom: 32px;
      max-width: 520px;
      font-weight: 400;
    }
    .hero-sub strong { color: var(--white); font-weight: 700; }
    .hero-sub em { font-style: italic; color: var(--orange); font-weight: 600; }

    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 22px 40px;
      background: var(--orange);
      color: var(--white);
      font-family: 'Open Sans', sans-serif;
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 4px;
      transition: all 0.2s;
      box-shadow: 0 8px 28px var(--orange-glow);
    }
    .hero-cta:hover {
      background: var(--orange-hover);
      transform: translateY(-2px);
      box-shadow: 0 12px 36px var(--orange-glow);
    }
    .hero-cta svg {
      width: 18px;
      height: 18px;
      fill: var(--white);
    }
    .hero-meta {
      display: block;
      margin-top: 16px;
      font-size: 13px;
      color: #90aac4;
      letter-spacing: 0.02em;
    }

    /* Book cover */
    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }
    .book-cover-wrap {
      position: relative;
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
    }
    .book-cover-wrap img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
      box-shadow:
        -12px 20px 60px rgba(0,0,0,0.6),
        0 0 0 1px rgba(255,255,255,0.05);
    }
    .book-badge {
      position: absolute;
      top: -14px;
      right: -14px;
      background: var(--orange);
      color: var(--white);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 10px 16px;
      border-radius: 3px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.4);
    }

    /* ── TRUST STRIP ── */
    .trust {
      background: var(--navy-dark);
      padding: 18px 24px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .trust-inner {
      max-width: 1080px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 48px;
      flex-wrap: wrap;
    }
    .trust-item {
      font-size: 13px;
      font-weight: 600;
      color: #b8c8d8;
      display: flex;
      align-items: center;
      gap: 8px;
      letter-spacing: 0.02em;
    }
    .trust-icon {
      width: 16px;
      height: 16px;
      fill: var(--orange);
      flex-shrink: 0;
    }

    /* ── DONATION SECTION (THE CLIMAX) ── */
    .donation-section {
      background: var(--off-white);
      padding: 100px 24px 120px;
      position: relative;
    }
    .donation-section::before {
      content: '';
      position: absolute;
      top: 0; left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 5px;
      background: var(--orange);
    }
    .donation-inner {
      max-width: 1080px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 45fr 55fr;
      gap: 72px;
      align-items: center;
    }
    .donation-copy { text-align: left; }
    .donation-form { display: flex; justify-content: center; }
    .donation-label {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 16px;
    }
    .donation-section h2 {
      font-family: 'Merriweather', serif;
      font-size: clamp(30px, 3.4vw, 44px);
      font-weight: 900;
      color: var(--navy);
      line-height: 1.1;
      margin-bottom: 22px;
      letter-spacing: -0.01em;
    }
    .donation-section h2 em {
      font-style: italic;
      color: var(--orange);
    }
    .donation-lead {
      font-size: 18px;
      color: var(--text);
      line-height: 1.6;
      margin: 0 0 32px;
    }
    .donation-lead strong { color: var(--navy); font-weight: 700; }

    /* Classy embed — natural size, centered in its column */
    #classy-embed {
      display: block;
      width: 100%;
      max-width: 100%;
    }

    .donation-assurance {
      display: flex;
      flex-direction: column;
      gap: 12px;
      font-size: 14px;
      color: var(--muted);
      font-weight: 600;
    }
    .donation-assurance span {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .donation-assurance svg {
      width: 16px;
      height: 16px;
      fill: var(--orange);
      flex-shrink: 0;
    }

    /* ── WHAT'S INSIDE ── */
    .inside {
      background: var(--white);
      padding: 90px 24px;
    }
    .inside-inner {
      max-width: 1080px;
      margin: 0 auto;
    }
    .inside-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 56px;
    }
    .inside-header .donation-label { color: var(--orange); }
    .inside-header h2 {
      font-family: 'Merriweather', serif;
      font-size: clamp(30px, 3.8vw, 46px);
      font-weight: 900;
      color: var(--navy);
      line-height: 1.15;
      margin: 14px 0 16px;
      letter-spacing: -0.01em;
    }
    .inside-header p {
      font-size: 17px;
      color: var(--muted);
      line-height: 1.6;
    }
    .toc-list {
      list-style: none;
      max-width: 640px;
      margin: 0 auto;
      padding: 0;
      counter-reset: none;
    }
    .toc-list li {
      display: flex;
      align-items: baseline;
      gap: 22px;
      padding: 20px 4px;
      border-bottom: 1px solid var(--border);
    }
    .toc-list li:first-child { border-top: 1px solid var(--border); }
    .toc-num {
      flex-shrink: 0;
      font-family: 'Merriweather', serif;
      font-style: italic;
      font-weight: 400;
      font-size: 15px;
      color: var(--orange);
      letter-spacing: 0.04em;
      min-width: 38px;
    }
    .toc-title {
      font-family: 'Merriweather', serif;
      font-weight: 700;
      font-size: 19px;
      color: var(--navy);
      line-height: 1.4;
    }

    /* ── FINAL CTA BAR ── */
    .final-cta {
      background: var(--navy);
      padding: 64px 24px;
      text-align: center;
      color: var(--white);
    }
    .final-cta h3 {
      font-family: 'Merriweather', serif;
      font-size: clamp(26px, 3.4vw, 40px);
      font-weight: 900;
      line-height: 1.15;
      margin-bottom: 18px;
      letter-spacing: -0.01em;
    }
    .final-cta h3 em {
      font-style: italic;
      color: var(--orange);
    }
    .final-cta p {
      font-size: 17px;
      color: #c8d8e8;
      margin-bottom: 32px;
      max-width: 540px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    /* ── FOOTER ── */
    footer {
      background: var(--navy-deep);
      padding: 32px 24px;
      text-align: center;
    }
    .footer-logo {
      font-family: 'Merriweather', serif;
      font-weight: 700;
      font-size: 16px;
      color: var(--white);
      margin-bottom: 10px;
    }
    footer p {
      font-size: 12px;
      color: #7090b0;
      line-height: 1.7;
    }
    footer a {
      color: #7090b0;
      text-decoration: none;
    }
    footer a:hover { color: #a8c4e0; }

    .site-credit {
      text-align: center;
      font-size: 13px;
      color: #8a8580;
      padding: 22px 24px 28px;
      background: var(--white);
      margin: 0;
    }
    .site-credit a {
      color: #8a8580;
      text-decoration: underline;
    }
    .site-credit a:hover { color: var(--navy); }

    /* ── RESPONSIVE ── */
    @media (max-width: 880px) {
      .hero-inner {
        grid-template-columns: 1fr;
        gap: 44px;
        text-align: center;
      }
      .hero-visual { order: -1; }
      .hero-sub { max-width: 100%; margin-left: auto; margin-right: auto; }
      .hero-cta { width: 100%; justify-content: center; }
      .book-cover-wrap { max-width: 280px; margin: 0 auto; }
      .trust-inner { gap: 22px; }
      .toc-list li { gap: 14px; padding: 16px 4px; }
      .toc-num { min-width: 32px; font-size: 14px; }
      .toc-title { font-size: 17px; }
      .donation-section { padding: 60px 20px 70px; }
      .donation-inner { grid-template-columns: 1fr; gap: 40px; }
      .donation-copy { text-align: center; }
      .donation-assurance { align-items: center; }
      .inside { padding: 60px 20px; }
    }
  </style>
</head>
